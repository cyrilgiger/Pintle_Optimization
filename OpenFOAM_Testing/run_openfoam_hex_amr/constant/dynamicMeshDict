FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}

// dynamicFvMesh   dynamicMultiDimRefineBalancedFvMesh; //dynamicMultiDimRefineFvMesh
dynamicFvMesh   dynamicRefineFvMesh;

// enableBalancing true;
// allowableImbalance 0.10;

dynamicRefineFvMeshCoeffs
{
    // How often to evaluate and refine
    refineInterval  20;

    // Field to refine on
    field           alpha.lox;

    // Refine cells where 0.001 < alpha.lox < 0.999
    lowerRefineLevel 0.01;
    upperRefineLevel 0.99;

    // Unrefine cells when interface leaves and value drops below threshold
    unrefineLevel    10.0;

    // Transition buffer layers
    nBufferLayers    3;

    // Max refinement cuts per cell
    maxRefinement    4;

    // Stop refinement if maxCells reached
    maxCells         5000000;

    // Flux fields to correct on changed faces
    correctFluxes
    (
        (phi none)
        (nHatf none)
        (rhoPhi none)
        (ghf none)
        (dVf_ none)
        (alphaPhi_ none)
    );

    // Write refinement level as a volScalarField
    dumpLevel        true;

    protectedPatches ();
}

