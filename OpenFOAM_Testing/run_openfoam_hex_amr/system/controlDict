FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     atomizationFoam;

deltaT          1e-5;

writeControl    adjustable;

writeInterval   0.5e-4;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.7;

maxAlphaCo      0.5;

maxDeltaT       1;

startFrom       latestTime; // latestTime - Automatically picks up the latest saved time folder
stopAt          endTime;    // to stop now: writeNow
endTime         0.002;
startTime       0.0;

functions
{
    planeDropletAnalysis
    {
        type            coded;
        libs            ("libutilityFunctionObjects.so");
        name            planeDropletAnalysis;

        // Controls when it runs
        writeControl    timeStep;
        writeInterval   1;

        codeExecute
        #{
            // -----------------------------------------------------------------
            // 1. Grab the mesh from the OpenFOAM database automatically
            // -----------------------------------------------------------------
            const fvMesh& mesh = refCast<const fvMesh>(obr_);

            // -----------------------------------------------------------------
            // 2. Fetch required fields straight from the mesh memory
            // -----------------------------------------------------------------
            // Change "alpha.water" to match your phase fraction field name if needed
            const volScalarField& alpha = mesh.lookupObject<volScalarField>("alpha.lox");
            // const volVectorField& U     = mesh.lookupObject<volVectorField>("U");

            // -----------------------------------------------------------------
            // 3. Create your local vofID field (no OOP class required!)
            // -----------------------------------------------------------------
            volScalarField vofID
            (
                IOobject
                (
                    "vofID_local",
                    mesh.time().timeName(),
                    mesh,
                    IOobject::NO_READ,
                    IOobject::NO_WRITE
                ),
                mesh,
                dimensionedScalar("zero", dimless, 0.0)
            );

            // Plane parameters
            scalar plane_x = 25e-3; // plane distance downstream
            scalar alphaLimit = 0.002;
            
            // check connection helper function
            auto checkConnection = [&](const label startCell, const scalar currentID)
            {
                vofID[startCell] = currentID;

                DynamicList<label> cells(0);
                cells.append(mesh.cellCells()[startCell]); // get neighbors of start cell (cellCells)

                while (cells.size() > 0)
                {
                    DynamicList<label> neighbours(0);

                    forAll(cells, i)
                    {
                        label cellI = cells[i];
                        // if liquid and different from the current cell cluster
                        if (alpha[cellI] > alphaLimit && mag(vofID[cellI] - currentID) > 0.1)
                        {
                            vofID[cellI] = currentID;
                            neighbours.append(mesh.cellCells()[cellI]);
                        }
                    }
                    cells.clear();
                    cells.transfer(neighbours);
                }
            };

            // -----------------------------------------------------------------
            // 4. Global Connected Component Labeling (CCL)
            // -----------------------------------------------------------------
            globalIndex globalNumbering(mesh.nCells());

            forAll(mesh.cells(), cellI)
            {
                label globalCellID = globalNumbering.toGlobal(cellI);

                // If cell has fluid and hasn't been tagged yet - i.e. vofID[cellI] = 0, and then unique cell label i different from 0
                if (alpha[cellI] > alphaLimit && mag(vofID[cellI]) < 0.1)
                {
                    checkConnection(cellI, scalar(globalCellID + 1));
                }
            }
            vofID.correctBoundaryConditions();

            // Parallel boundary corrections across processors
            label corr = Foam::log(scalar(Pstream::nProcs())) / Foam::log(2.0) + 1;
            for (int i = 0; i <= corr; i++)
            {
                forAll(mesh.boundary(), patchI)
                {
                    const fvPatch& pPatch = mesh.boundary()[patchI];
                    if (pPatch.coupled())
                    {
                        forAll(pPatch, faceI)
                        {
                            const scalar ID_own = vofID.boundaryField()[patchI].patchInternalField()()[faceI];
                            const scalar ID_nei = vofID.boundaryField()[patchI].patchNeighbourField()()[faceI];

                            if ((ID_nei > 0.1) && (ID_own > 0.1) && (mag(ID_nei - ID_own) > 0.1))
                            {
                                scalar minID = Foam::min(ID_own, ID_nei);
                                scalar maxID = Foam::max(ID_own, ID_nei);
                                scalar diff = maxID - minID;

                                volScalarField filtered = diff
                                    * pos(vofID - maxID + 0.1)
                                    * pos(-vofID + maxID + 0.1);

                                vofID -= filtered;
                            }
                        }
                    }
                }
                vofID.correctBoundaryConditions();
            }

            // Renumber unique continuous IDs from largest ID to smallest
            {
                volScalarField tmp(vofID);
                scalar maxID = gMax(tmp);
                vofID = 0.0;
                int iter = 1;
                while (maxID > 0.1)
                {
                    volScalarField curVolID = pos(tmp - maxID + 0.1); // mask for only cells from droplet maxID
                    vofID += iter * curVolID;
                    tmp -= maxID * curVolID; // remove maxID cells from tmp vofID
                    maxID = gMax(tmp);
                    iter++;
                }
            }
            label maxID = label(round(gMax(vofID)));

            // -----------------------------------------------------------------
            // 5. Plane Intersection & Equivalent Diameter Calculation
            // -----------------------------------------------------------------
            tmp<volScalarField> tmagGradAlpha = Foam::mag(fvc::grad(alpha));
            const scalarField& magGradAlphaI = tmagGradAlpha().primitiveField();
            const scalarField& alphaI        = alpha.primitiveField();
            const scalarField& V             = mesh.V();
            const pointField&  C             = mesh.C().primitiveField();
            const scalarField& vofIDI        = vofID.primitiveField();
            
            scalarField volume(maxID + 1, 0.0);
            scalarField surface(maxID + 1, 0.0);
            boolList localIntersectsPlane(maxID + 1, false);

            forAll(mesh.cells(), cellI)
            {
                if (vofIDI[cellI] > 0.1) // Cell is part of a droplet
                {
                    label volID = label(round(vofIDI[cellI]));

                    // Accumulate volume & surface area
                    volume[volID]  += alphaI[cellI] * V[cellI];
                    surface[volID] += magGradAlphaI[cellI] * V[cellI];

                    // Plane proximity check (+/- 0.5 * dx)
                    scalar dist = mag(C[cellI].x() - plane_x);
                    scalar dx   = Foam::cbrt(V[cellI]);

                    if (dist <= 0.5 * dx)
                    {
                        localIntersectsPlane[volID] = true;
                    }
                }
            }

            // Reduce data across parallel ranks
            reduce(volume, sumOp<scalarList>()); // sum up volumes calculated on each processor
            reduce(surface, sumOp<scalarList>());
            
            labelList globalIntersects(maxID + 1, 0); // convert to label list for reduction ("globalization") of array
            forAll(localIntersectsPlane, i)
            {
                globalIntersects[i] = localIntersectsPlane[i] ? 1 : 0;
            }
            reduce(globalIntersects, maxOp<labelList>()); // check if droplet crossed plane on any processor

            // Print output on master node
            if (Pstream::master())
            {
                // Creates or appends to "plane_droplets.csv" in the case directory
                fileName outputDir = mesh.time().globalPath() / "postProcessing";
                mkDir(outputDir);
                
                OFstream outFile(outputDir / "plane_droplets.csv", IOstreamOption(), IOstreamOption::APPEND);

                // Optional: write CSV header if starting a new file
                if (mesh.time().timeIndex() == 1)
                {
                    outFile << "t,DropletID,V,A" << endl;
                }

                for (label i = 1; i <= maxID; i++)
                {
                    if (globalIntersects[i] && volume[i] > VSMALL)
                    {
                        outFile << mesh.time().value() << ","
                                << i << ","
                                << volume[i] << ","
                                << surface[i] << endl;
                    }
                }
            }
        #};
    }
}

