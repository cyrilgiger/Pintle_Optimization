FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          transportProperties;
}

phases          ( fluid gas );

fluid
{
    transportModel  Newtonian;
    nu              1.75e-07;
    rho             1154;
}

gas
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             1.744;
}

sigma           0.0132;


