FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (fluid gas);

fluid
{
    transportModel  Newtonian;
    nu              1.75e-7;
    rho             1145.4434108400221;
}

gas
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             1.7440;
}

sigma           0.0132;

