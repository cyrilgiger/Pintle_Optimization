FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    fluidDomain_inlet_o
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.475;
        rhoInlet        1145.4434108400221;
    }

    fluidDomain_inlet_f
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.325;
        rhoInlet        1145.4434108400221;
    }

    "fluidDomain_wall_.*"
    {
        type            noSlip;
    }

    fluidDomain_outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "periodicAMI_.*"
    {
        type            cyclicAMI;
    }
}


