FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "fluidDomain_inlet_.*"
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    "fluidDomain_wall_.*"
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    fluidDomain_outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

    "periodicAMI_.*"
    {
        type            cyclicAMI;
    }
}
