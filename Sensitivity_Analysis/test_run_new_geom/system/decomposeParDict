FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  6;

method          scotch;

constraints
{
    keepAMIOnProcessor0
    {
        type singleProcessorFaceSets;
        sets
        (
            (ami0Faces 0)       // force on processor 0
            (amiRevFaces 0)     // force on processor 0
        );
    }
}

